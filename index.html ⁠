  font-size: clamp(38px, 7vw, 68px);
  line-height: 1.08;
  max-width: 800px;
  margin: 18px 0;
}
h1 span { color: #49a6ff; }
.hero p {
  max-width: 650px;
  color: var(--muted);
  font-size: 18px;
}
.buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 28px;
}
.btn {
  display: inline-block;
  text-decoration: none;
  padding: 13px 20px;
  border-radius: 7px;
  font-weight: bold;
}
.primary { background: var(--blue); color: white; }
.secondary { border: 1px solid #61758e; }
section { padding: 65px 7%; }
.section-title {
  font-size: clamp(27px, 4vw, 38px);
  margin: 0 0 12px;
}
.intro { color: var(--muted); max-width: 680px; }
.services {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 30px;
}
.service {
  background: var(--panel);
  border: 1px solid #293b52;
  border-radius: 12px;
  padding: 23px;
}
.symbol { font-size: 28px; }
.service h3 { margin: 10px 0 5px; }
.service p { color: var(--muted); margin-bottom: 0; }
.light {
  background: var(--light);
  color: #102036;
}
.light .intro { color: #526175; }
.steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 28px;
}
.step {
  padding: 20px;
  border: 1px solid #dce4ee;
  border-radius: 10px;
}
.step strong {
  color: #0875df;
  font-size: 22px;
}
.contact-box {
  background: var(--panel);
  padding: 30px;
  border-radius: 14px;
  border: 1px solid #293b52;
}
footer {
